# Frontend environment (example). Copy to .env.local and fill in real values.

# Base URL of the Django/Wagtail API (consumed by src/services/client.ts baseFetch).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Serve mock data (MSW / service-swap) instead of the real API — frontend-first default.
NEXT_PUBLIC_USE_MOCKS=true
